<Window x:Class="ToneDetector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToneDetector.App"
        xmlns:converters="clr-namespace:ToneDetector.App.Converters"
        xmlns:controls="clr-namespace:ToneDetector.App.Controls"
        xmlns:views="clr-namespace:ToneDetector.App.Views"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="Music Station" Height="820" Width="1200" MinWidth="1000" MinHeight="800" WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <converters:MinWidthToVisibilityConverter x:Key="MinWidthToVisibility"/>

        <!-- Navigation header shared by every tab (Design/Header.dc.html): 72px, app mark and name,
             tabs, then input device · sample rate and the listening pill. Replaces the old tab bar.
             The device block drops out when its slot can't fit the mic, the rate and ~60px of name
             (182px); at the 1000px minimum window width only the device block is gone. -->
        <Style x:Key="MainTabs" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavTab}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource BgChrome}" BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="0,0,0,1" Padding="32,0" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- App mark: five rounded strokes in Accent. Do not stretch. -->
                                        <Viewbox Width="32" Height="32" Stretch="Uniform">
                                            <Canvas Width="32" Height="32">
                                                <Path Data="M 5 12 L 5 20 M 11 7 L 11 25 M 17 3 L 17 29 M 23 9 L 23 23 M 29 13 L 29 19"
                                                      Stroke="{StaticResource Accent}" StrokeThickness="2.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Style="{StaticResource Title}" Text="Music Station" Margin="14,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Ink}"/>
                                    </StackPanel>

                                    <!-- Tabs. A StackPanel, not a TabPanel, so they never wrap onto a second row. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" IsItemsHost="True"
                                                KeyboardNavigation.TabIndex="1"
                                                AutomationProperties.Name="Main"/>

                                    <Border x:Name="DeviceSlot" Grid.Column="3" Margin="24,0,0,0">
                                        <views:HeaderDevice HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Visibility="{Binding ActualWidth, ElementName=DeviceSlot, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=182}"/>
                                    </Border>

                                    <views:ListeningPill Grid.Column="5" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <TabControl x:Name="MainTabControl" Style="{StaticResource MainTabs}" SelectionChanged="MainTabControl_SelectionChanged">

        <TabItem Header="Home">
            <views:HomeView OpenPianoRollRequested="HomeView_OpenPianoRollRequested"/>
        </TabItem>

        <TabItem x:Name="LiveTunerTabItem" Header="Live Tuner">
            <views:LiveTunerView x:Name="LiveTunerPage"/>
        </TabItem>

        <TabItem x:Name="FileAnalysisTabItem" Header="File Analysis">
            <views:FileAnalysisView x:Name="FileAnalysisPage"/>
        </TabItem>

        <TabItem x:Name="SettingsTabItem" Header="Settings">
            <views:SettingsView ShowPluginEditorRequested="SettingsView_ShowPluginEditorRequested"/>
        </TabItem>

    </TabControl>
</Window>
