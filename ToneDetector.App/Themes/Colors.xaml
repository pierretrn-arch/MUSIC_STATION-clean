<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Music Station colour tokens. Source of truth: Design/tokens.json (v2).
         Each token is a Color ({Name}Color, for animations and gradients) and a
         SolidColorBrush ({Name}, for fills, strokes and text). -->

    <!-- ================= Colors ================= -->
    <Color x:Key="BgColor">#0F1012</Color>
    <Color x:Key="BgChromeColor">#131417</Color>
    <Color x:Key="SurfaceColor">#17181B</Color>
    <Color x:Key="SurfaceRaisedColor">#1F2125</Color>
    <Color x:Key="SurfaceActiveColor">#2A2D33</Color>
    <Color x:Key="BorderSubtleColor">#25272C</Color>
    <Color x:Key="BorderColor">#34373D</Color>
    <Color x:Key="BorderStrongColor">#4A4E56</Color>
    <Color x:Key="InkColor">#E8E6E1</Color>
    <Color x:Key="InkStrongColor">#F4F2EE</Color>
    <Color x:Key="InkMutedColor">#C9CBD0</Color>
    <Color x:Key="InkSubtleColor">#A3A6AD</Color>
    <Color x:Key="InkFaintColor">#6B6F77</Color>
    <Color x:Key="AccentColor">#F2A541</Color>
    <Color x:Key="OnAccentColor">#1A1307</Color>
    <!-- rgba(242,165,65,0.15): alpha 0x26 = 0.149 -->
    <Color x:Key="AccentTintColor">#26F2A541</Color>
    <Color x:Key="PitchColor">#5FB3E8</Color>
    <Color x:Key="PitchTextColor">#8CCBF0</Color>
    <Color x:Key="PitchWellColor">#13232E</Color>
    <Color x:Key="OnPitchColor">#0B1A24</Color>
    <Color x:Key="PitchEdgeColor">#24475C</Color>
    <!-- rgba(95,179,232,0.16): alpha 0x29 = 0.161 -->
    <Color x:Key="PitchLaneColor">#295FB3E8</Color>
    <Color x:Key="SelectionRingColor">#DCEFFB</Color>
    <Color x:Key="RecordColor">#F0625F</Color>
    <Color x:Key="MuteColor">#E0B84A</Color>
    <Color x:Key="KeyWhiteColor">#D9D6CF</Color>
    <Color x:Key="KeyBlackColor">#2A2C31</Color>
    <Color x:Key="KeyWhiteHoverColor">#ECEAE4</Color>
    <Color x:Key="KeyBlackHoverColor">#3A3D44</Color>
    <Color x:Key="KeyLabelColor">#3A3D44</Color>
    <Color x:Key="LaneWhiteColor">#1A1C20</Color>
    <Color x:Key="LaneBlackColor">#141518</Color>
    <Color x:Key="GhostNoteColor">#3A3D44</Color>

    <!-- ================= Brushes ================= -->
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BgChrome" Color="{StaticResource BgChromeColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceActive" Color="{StaticResource SurfaceActiveColor}"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="InkStrong" Color="{StaticResource InkStrongColor}"/>
    <SolidColorBrush x:Key="InkMuted" Color="{StaticResource InkMutedColor}"/>
    <SolidColorBrush x:Key="InkSubtle" Color="{StaticResource InkSubtleColor}"/>
    <!-- Decorative only (separators, inactive dots): below 4.5:1, never for text that must be read -->
    <SolidColorBrush x:Key="InkFaint" Color="{StaticResource InkFaintColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="AccentTint" Color="{StaticResource AccentTintColor}"/>
    <SolidColorBrush x:Key="Pitch" Color="{StaticResource PitchColor}"/>
    <SolidColorBrush x:Key="PitchText" Color="{StaticResource PitchTextColor}"/>
    <SolidColorBrush x:Key="PitchWell" Color="{StaticResource PitchWellColor}"/>
    <SolidColorBrush x:Key="OnPitch" Color="{StaticResource OnPitchColor}"/>
    <SolidColorBrush x:Key="PitchEdge" Color="{StaticResource PitchEdgeColor}"/>
    <SolidColorBrush x:Key="PitchLane" Color="{StaticResource PitchLaneColor}"/>
    <SolidColorBrush x:Key="SelectionRing" Color="{StaticResource SelectionRingColor}"/>
    <SolidColorBrush x:Key="Record" Color="{StaticResource RecordColor}"/>
    <SolidColorBrush x:Key="Mute" Color="{StaticResource MuteColor}"/>
    <SolidColorBrush x:Key="KeyWhite" Color="{StaticResource KeyWhiteColor}"/>
    <SolidColorBrush x:Key="KeyBlack" Color="{StaticResource KeyBlackColor}"/>
    <SolidColorBrush x:Key="KeyWhiteHover" Color="{StaticResource KeyWhiteHoverColor}"/>
    <SolidColorBrush x:Key="KeyBlackHover" Color="{StaticResource KeyBlackHoverColor}"/>
    <SolidColorBrush x:Key="KeyLabel" Color="{StaticResource KeyLabelColor}"/>
    <SolidColorBrush x:Key="LaneWhite" Color="{StaticResource LaneWhiteColor}"/>
    <SolidColorBrush x:Key="LaneBlack" Color="{StaticResource LaneBlackColor}"/>
    <!-- Notes of tracks you are not editing; outline them in BorderStrong -->
    <SolidColorBrush x:Key="GhostNote" Color="{StaticResource GhostNoteColor}"/>

    <!-- ================= Off-token mockup colours ================= -->
    <!-- The mockups use colours that are not tokens. Views must use the token on the right.
         Lines and outlines snap to the nearest border-* token; everything else to the nearest
         token by RGB distance. Key-* tokens are reserved for piano keys.

         #1C1E22  header icon button, Home link fill  -> SurfaceRaised
         #2E3137  header button outline, dividers     -> Border
         #3A3D44  selected project row outline        -> Border
         #3A3D44  Home piano roll preview bar line    -> Border
         #3A3D44  Master strip outline                -> BorderStrong (by decision)
         #1C1E22  Master strip fill                   -> SurfaceRaised (by decision)
         #2A2418  recent-project icon tile            -> AccentTint    (token since v2)
         #1A0707  record-arm label on Record fill     -> OnAccent      (by decision)
         #6B6F77  breadcrumb "/", compact meter centre -> InkFaint      (token since v2)
         #8A8E96  tuning meter centre line            -> InkSubtle     (large shift)
         #B7BAC0  Home panel description text         -> InkMuted
         #DCEFFB  selected note outline               -> SelectionRing (token since v2)
         #24475C  selected-note card outline, pill divider -> PitchEdge (token since v2)
         #FFFFFF  link hover                          -> InkStrong
         #23252A  compact meter track, velocity grid  -> BorderSubtle
         #2C2F35  piano roll beat line                -> Border
         #202226  piano roll / arrangement step line  -> BorderSubtle
         #1A1C20  piano roll white-key lane           -> LaneWhite     (token since v2)
         #141518  piano roll black-key lane           -> LaneBlack     (token since v2)
         #141518  velocity lane, arrangement lane,
                  mixer strip                         -> BgChrome
         #1B1D21  Home preview white-key lane         -> LaneWhite     (by decision)
         #16171A  Home preview black-key lane         -> LaneBlack     (by decision)
         #121316  Home preview well                   -> BgChrome

         Kept as token + opacity (not snapped): Pitch 16% (in-tune band; the detected lane is PitchLane),
         Pitch 30% (compact meter band), Pitch 45% (target dash), track colour 16% / 14%
         (track icon tile / clip fill), InkStrong 85% / 50% (playhead), note opacity by velocity,
         meter gradient Pitch -> Accent. -->

</ResourceDictionary>
