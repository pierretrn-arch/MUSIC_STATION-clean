<UserControl x:Class="ToneDetector.App.Views.LiveTunerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ToneDetector.App.Controls"
             xmlns:converters="clr-namespace:ToneDetector.App.Converters"
             xmlns:views="clr-namespace:ToneDetector.App.Views"
             Background="{StaticResource Bg}"
             Foreground="{StaticResource Ink}"
             FontFamily="{StaticResource Sans}"
             FontSize="{StaticResource BodyFontSize}"
             PreviewKeyDown="View_PreviewKeyDown">

    <!-- Live Tuner (Design/LiveTuner.dc.html): session bar (Record, Clear, transport, Tempo,
         Metronome, Export ▾), the tuner panel, the shared editor tool bar, Tracks list, the piano
         roll, and a collapsible 440px side panel with Grid | Notation. DataContext is the
         MainViewModel; the roll is PianoRoll. -->

    <UserControl.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- Record, or Stop recording on a Record fill while recording -->
        <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Command" Value="{Binding PianoRoll.RecordCommand}"/>
            <Setter Property="ToolTip" Value="Record the notes you play or sing into the piano roll, from the playhead. With the metronome on, a 1-bar count-in comes first."/>
            <Setter Property="Content">
                <Setter.Value>
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource IconFilled}" Content="{StaticResource IconRecordDot}"
                                        Foreground="{StaticResource Record}" Width="14" Height="14"/>
                        <TextBlock Text="Record" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PianoRoll.IsCountingIn}" Value="True">
                    <Setter Property="Command" Value="{Binding PianoRoll.StopRecordingCommand}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Record}"/>
                    <Setter Property="ToolTip" Value="Cancel the count-in"/>
                    <Setter Property="Content">
                        <Setter.Value>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource IconFilled}" Content="{StaticResource IconRecordDot}"
                                                Foreground="{StaticResource Record}" Width="14" Height="14"/>
                                <TextBlock Text="Counting in…" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding LiveTuner.IsRecording}" Value="True">
                    <Setter Property="Command" Value="{Binding PianoRoll.StopRecordingCommand}"/>
                    <Setter Property="Background" Value="{StaticResource Record}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Record}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                    <Setter Property="ToolTip" Value="Stop recording"/>
                    <Setter Property="Content">
                        <Setter.Value>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource IconFilled}" Content="{StaticResource IconStopLarge}"
                                                Width="14" Height="14"/>
                                <TextBlock Text="Stop recording" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Content is the LiveTunerViewModel -->
        <DataTemplate x:Key="NotationTemplate">
            <controls:NotationView
                Transcript="{Binding NotationEntries}"
                TempoBpm="{Binding Bpm}"
                NotationEnabled="{Binding DataContext.Visualization.NotationEnabled, RelativeSource={RelativeSource AncestorType=views:LiveTunerView}}"
                ThrottleMs="{Binding DataContext.Visualization.NotationUpdateThrottleMs, RelativeSource={RelativeSource AncestorType=views:LiveTunerView}}"/>
        </DataTemplate>

        <!-- Grid rows (RollGridRow): Note, Start (ms), Duration (ms), Confidence; the clicked row
             expands into Type, Gap since prev (ms), Cents and Chord tiles. -->
        <DataTemplate x:Key="GridRowTemplate">
            <StackPanel>
                <Grid Height="34" Margin="14,0" TextElement.FontFamily="{StaticResource Mono}"
                      TextElement.FontSize="{StaticResource LabelFontSize}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="104"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NoteCell" Grid.Column="0" Text="{Binding NoteText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding StartText}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel x:Name="ConfidenceCell" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Grid Width="44" Height="6" VerticalAlignment="Center">
                            <Border Background="{StaticResource SurfaceActive}" CornerRadius="3"/>
                            <Border x:Name="ConfidenceFill" Width="{Binding ConfidenceBarWidth}" HorizontalAlignment="Left"
                                    Background="{StaticResource InkSubtle}" CornerRadius="3"/>
                        </Grid>
                        <TextBlock Text="{Binding ConfidenceText}" FontSize="{StaticResource OverlineFontSize}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="Details" Margin="14,4,6,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Type"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding TypeText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Gap since prev (ms)"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding GapText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Cents"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding CentsText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Chord"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding ChordText}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Details" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NoteCell" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="ConfidenceFill" Property="Background" Value="{StaticResource Pitch}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSilence}" Value="True">
                    <Setter TargetName="NoteCell" Property="Foreground" Value="{StaticResource InkSubtle}"/>
                    <Setter TargetName="ConfidenceCell" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Session bar ================= -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1" Padding="32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource RecordButton}"/>
                    <Button Style="{StaticResource ButtonSecondary}" Height="44" Padding="16,0" Margin="8,0,0,0"
                            Command="{Binding PianoRoll.ClearCommand}" ToolTip="Remove every track and start again with one empty take">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconTrash}" Width="16" Height="16"/>
                            <TextBlock Text="Clear" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <views:SessionTransport Grid.Column="2" Roll="{Binding PianoRoll}"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <views:TempoControl Roll="{Binding PianoRoll}"/>
                    <ToggleButton Style="{StaticResource Toggle}" Height="44" Padding="14,0" Margin="12,0,0,0"
                                  IsChecked="{Binding PianoRoll.IsMetronomeOn}" AutomationProperties.Name="Metronome"
                                  ToolTip="Metronome, with a 1-bar count-in when recording">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconMetronome}" Width="16" Height="16"/>
                            <TextBlock Text="Metronome" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <Button Grid.Column="5" Margin="16,0,0,0" Style="{StaticResource ButtonSecondary}" Height="44" Padding="14,0"
                        controls:MenuButton.OpensContextMenu="True" AutomationProperties.Name="Export">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconDownload}" Width="16" Height="16"/>
                        <TextBlock Text="Export" Margin="10,0,10,0" VerticalAlignment="Center"/>
                        <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconChevronDown}" Width="14" Height="14"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource MenuPanel}">
                            <MenuItem Style="{StaticResource MenuEntry}" Header="JSON…" Command="{Binding LiveTuner.ExportJsonCommand}"/>
                            <MenuItem Style="{StaticResource MenuEntry}" Header="CSV…" Command="{Binding LiveTuner.ExportCsvCommand}"/>
                            <MenuItem Style="{StaticResource MenuEntry}" Header="MIDI…" Command="{Binding LiveTuner.ExportMidiCommand}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- ================= Tuner (open by default here) ================= -->
        <views:TunerPanel Grid.Row="1" IsExpanded="{Binding Visualization.LiveTunerTunerExpanded}"
                          PanelHeight="{Binding Visualization.LiveTunerTunerHeight}"/>

        <!-- ================= Editor tool bar ================= -->
        <views:EditorToolbar Grid.Row="2" Roll="{Binding PianoRoll}" Target="{Binding ElementName=PianoRoll}"/>

        <!-- ================= Tracks · piano roll · side panel ================= -->
        <Grid Grid.Row="3" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tracks -->
            <views:TracksPanel Grid.Column="0" Roll="{Binding PianoRoll}"/>

            <!-- Piano roll -->
            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusLg}">
                <Grid controls:RoundedClip.Radius="11">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:PianoRollControl x:Name="PianoRoll" Grid.Row="0" Grid.Column="0"
                        KeyColumnWidth="72" RulerRowHeight="40"
                        Editor="{Binding PianoRoll}"
                        IsLive="{Binding LiveTuner.IsRecording}"
                        DetectedNote="{Binding LiveTuner.DetectedMidiNote, Mode=OneWay}"
                        ColorByPitchClass="{Binding Visualization.PianoRollColorByPitchClass}"
                        SelectionChanged="PianoRoll_SelectionChanged"
                        AutomationProperties.Name="Piano roll"/>
                    <!-- Panning only makes sense once recording stops (the roll follows live time while recording) -->
                    <ScrollBar Grid.Row="0" Grid.Column="1" Orientation="Vertical" Width="14" Minimum="0" Margin="0,40,0,0"
                               Maximum="{Binding VerticalScrollMaximum, ElementName=PianoRoll, Mode=OneWay}"
                               ViewportSize="{Binding VisibleHeight, ElementName=PianoRoll, Mode=OneWay}"
                               Value="{Binding ViewTop, ElementName=PianoRoll, Mode=TwoWay}"
                               SmallChange="24" LargeChange="240" AutomationProperties.Name="Scroll notes up and down"/>
                    <ScrollBar Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Height="14" Minimum="0" Margin="72,0,0,0"
                               Maximum="{Binding ScrollMaximumBeats, ElementName=PianoRoll, Mode=OneWay}"
                               ViewportSize="{Binding VisibleBeats, ElementName=PianoRoll, Mode=OneWay}"
                               Value="{Binding ViewStartBeats, ElementName=PianoRoll, Mode=TwoWay}"
                               SmallChange="1" LargeChange="4"
                               Visibility="{Binding LiveTuner.IsRecording, Converter={StaticResource InverseBoolToVisibility}}"/>
                </Grid>
            </Border>

            <!-- Side panel: Grid | Notation -->
            <Border x:Name="SidePanel" Grid.Column="4" Width="440" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" Padding="20">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonGhost}" AutomationProperties.Name="Collapse panel"
                                Click="CollapseSidePanel_Click">
                            <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconChevronRight}" Width="16" Height="16" Tag="2.0"/>
                        </Button>
                        <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" AutomationProperties.Name="Side panel view">
                                <RadioButton x:Name="GridViewToggle" Style="{StaticResource ToggleSegment}" Height="36" Padding="18,0"
                                             Content="Grid" GroupName="SideView" IsChecked="True"/>
                                <RadioButton x:Name="NotationViewToggle" Style="{StaticResource ToggleSegment}" Height="36" Padding="18,0"
                                             Margin="3,0,0,0" Content="Notation" GroupName="SideView" Checked="NotationViewToggle_Checked"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Grid>
                        <!-- Grid view -->
                        <DockPanel Visibility="{Binding IsChecked, ElementName=GridViewToggle, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource CheckInput}" Content="Hide silence rows"
                                          IsChecked="{Binding LiveTuner.HideSilenceRows}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GridCaption" Style="{StaticResource Label}" FontSize="{StaticResource OverlineFontSize}"
                                           Foreground="{StaticResource InkSubtle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}">
                                <DockPanel controls:RoundedClip.Radius="7">
                                    <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource BgChrome}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                        <Grid Margin="14,0" TextElement.FontSize="{StaticResource OverlineFontSize}"
                                              TextElement.Foreground="{StaticResource InkSubtle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="104"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Note" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Start (ms)" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="Duration (ms)" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="3" Text="Confidence" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <Grid>
                                        <ListBox x:Name="NoteList" SelectionMode="Extended" ItemTemplate="{StaticResource GridRowTemplate}"
                                                 ItemContainerStyle="{StaticResource ResultItem}" Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Notes"
                                                 SelectionChanged="NoteList_SelectionChanged">
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter/>
                                                    </ScrollViewer>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                        </ListBox>
                                        <TextBlock x:Name="EmptyGridText" Style="{StaticResource Label}" Foreground="{StaticResource InkSubtle}"
                                                   Margin="14" Text="Record to see your notes here."/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DockPanel>

                        <!-- Notation view: created the first time Notation is picked (it starts WebView2) -->
                        <ContentControl x:Name="NotationHost" Focusable="False" ContentTemplate="{StaticResource NotationTemplate}"
                                        Visibility="{Binding IsChecked, ElementName=NotationViewToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <Button x:Name="ExpandSidePanelButton" Grid.Column="4" VerticalAlignment="Top" Visibility="Collapsed"
                    Style="{StaticResource ButtonGhost}" AutomationProperties.Name="Show side panel" ToolTip="Show Grid and Notation"
                    Click="ExpandSidePanel_Click">
                <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconChevronLeft}" Width="16" Height="16" Tag="2.0"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
