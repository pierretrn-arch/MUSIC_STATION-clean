<Window x:Class="ToneDetector.App.Views.MidiPartsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load MIDI parts"
        Width="480" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Surface}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource Sans}" FontSize="{StaticResource BodyFontSize}">

    <!-- Which tracks/channels of a MIDI file to load into File Analysis. All are merged into the
         one roll (there's no multi-track yet); drums start unticked. -->

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="Load MIDI parts"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Foreground="{StaticResource InkMuted}" TextWrapping="Wrap"
                   Margin="0,8,0,16" Text="This file has several parts. The ticked ones are loaded together into the piano roll."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource ButtonSecondary}" Height="44" Padding="16,0" Content="Cancel" IsCancel="True"/>
            <Button x:Name="LoadButton" Style="{StaticResource ButtonPrimary}" Height="44" Padding="16,0" Margin="8,0,0,0"
                    Content="Load" IsDefault="True" Click="Load_Click"/>
        </StackPanel>

        <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                <ItemsControl x:Name="PartList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource CheckInput}" IsChecked="{Binding IsSelected}" Margin="8,6"
                                      Checked="Part_Changed" Unchecked="Part_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource MetaFontSize}"
                                               Foreground="{StaticResource InkSubtle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
