<UserControl x:Class="ToneDetector.App.Views.SessionTransport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">

    <!-- The session bar's one transport (Design/LiveTuner.dc.html, FileAnalysis.dc.html): Rewind,
         Play (Pause while playing), Stop, Loop and the position in bar.beat.step. Each tab has
         exactly one, bound to that tab's piano roll (Roll), so Play always plays this tab's notes. -->

    <UserControl.Resources>
        <Style x:Key="PlayPause" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="AutomationProperties.Name" Value="Play"/>
            <Setter Property="ToolTip" Value="Play from the playhead"/>
            <Setter Property="Content">
                <Setter.Value>
                    <ContentControl Style="{StaticResource IconFilled}" Content="{StaticResource IconPlay}" Width="20" Height="20"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Roll.IsPlaying, ElementName=Root}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="Pause"/>
                    <Setter Property="ToolTip" Value="Pause (the playhead stays here)"/>
                    <Setter Property="Content">
                        <Setter.Value>
                            <ContentControl Style="{StaticResource IconFilled}" Content="{StaticResource IconPause}" Width="20" Height="20"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource ButtonIcon}" Foreground="{StaticResource Ink}" AutomationProperties.Name="Rewind"
                ToolTip="Back to the start" Command="{Binding Roll.RewindCommand, ElementName=Root}">
            <ContentControl Style="{StaticResource IconFilled}" Content="{StaticResource IconRewind}" Width="18" Height="18"/>
        </Button>
        <Button Style="{StaticResource PlayPause}" Margin="8,0,0,0" Command="{Binding Roll.PlayPauseCommand, ElementName=Root}"/>
        <Button Style="{StaticResource ButtonIcon}" Foreground="{StaticResource Ink}" AutomationProperties.Name="Stop (press again to go to 0)"
                ToolTip="Stop: back to the loop start, press again to go to 0" Margin="8,0,0,0"
                Command="{Binding Roll.StopCommand, ElementName=Root}">
            <ContentControl Style="{StaticResource IconFilled}" Content="{StaticResource IconStopLarge}" Width="16" Height="16"/>
        </Button>
        <ToggleButton Style="{StaticResource Toggle}" Height="44" Padding="14,0" Margin="8,0,0,0"
                      IsChecked="{Binding Roll.IsLoopEnabled, ElementName=Root}"
                      ToolTip="Play the region between the S and E handles on the ruler over and over">
            <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconLoop}" Width="16" Height="16"/>
                <TextBlock Text="Loop" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>

        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center" MinWidth="150">
            <TextBlock Style="{StaticResource Caption}" FontWeight="Normal" Foreground="{StaticResource InkSubtle}" Text="Position"/>
            <TextBlock Style="{StaticResource ReadoutSm}" AutomationProperties.Name="Playback position">
                <Run Text="{Binding Roll.PositionText, ElementName=Root, Mode=OneWay}"/><Run
                     Text=" / " Foreground="{StaticResource InkSubtle}"/><Run
                     Text="{Binding Roll.EndText, ElementName=Root, Mode=OneWay}" Foreground="{StaticResource InkSubtle}"/>
            </TextBlock>
        </StackPanel>
    </StackPanel>
</UserControl>
