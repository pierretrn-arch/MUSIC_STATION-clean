<UserControl x:Class="ToneDetector.App.Views.TempoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">

    <!-- Tempo: [120] BPM with ▲▼ (40-240, step 1) and a fixed 4/4 (Design/LiveTuner.dc.html).
         Typing applies on Enter or when the box loses focus; anything out of range is clamped. -->

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource BarLabel}" Text="Tempo" Margin="0,0,10,0"/>
        <Border Height="44" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TempoBox" Width="56" Height="42" Padding="10,0,4,0" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}" SelectionBrush="{StaticResource Pitch}"
                         FontFamily="{StaticResource Mono}" FontSize="18" TextAlignment="Right" VerticalContentAlignment="Center"
                         MaxLength="3" AutomationProperties.Name="Tempo in BPM"
                         ToolTip="Tempo, 40-240 BPM. Notes stay on their beats when you change it."
                         KeyDown="TempoBox_KeyDown" LostKeyboardFocus="TempoBox_LostKeyboardFocus"
                         PreviewTextInput="TempoBox_PreviewTextInput" GotKeyboardFocus="TempoBox_GotKeyboardFocus"/>
                <TextBlock Text="BPM" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource InkSubtle}"
                           VerticalAlignment="Center" Margin="4,0,8,0"/>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                    <StackPanel>
                        <Button Style="{StaticResource TempoStep}" BorderThickness="0,0,0,1" AutomationProperties.Name="Increase tempo"
                                Command="{Binding Roll.IncreaseTempoCommand, ElementName=Root}">
                            <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconChevronUp}" Width="10" Height="10" Tag="3.0"/>
                        </Button>
                        <Button Style="{StaticResource TempoStep}" BorderThickness="0" AutomationProperties.Name="Decrease tempo"
                                Command="{Binding Roll.DecreaseTempoCommand, ElementName=Root}">
                            <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconChevronDown}" Width="10" Height="10" Tag="3.0"/>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock Text="4/4" FontFamily="{StaticResource Mono}" FontSize="16" Foreground="{StaticResource InkMuted}"
                   VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Time signature"/>
    </StackPanel>
</UserControl>
