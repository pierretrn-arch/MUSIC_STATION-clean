<UserControl x:Class="ToneDetector.App.Views.TracksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ToneDetector.App.Controls"
             x:Name="Root"
             Focusable="False">

    <!-- Tracks panel (Design/FileTracks.dc.html), both editing tabs: one card per track with
         colour swatch, name, M / S, instrument picker, volume fader (no jump-to-click) with dB, and
         pan. Click a card to edit that track; the selected card is SurfaceRaised with a BorderStrong
         outline and a muted card drops to 60%. Right-click for Rename / Colour / Delete; double-click
         the name to rename. "+ Add track" (dashed) at the bottom. -->

    <UserControl.Resources>
        <DataTemplate x:Key="TrackCard">
            <Border x:Name="Card" Margin="0,0,0,8" Padding="10" CornerRadius="10" BorderThickness="1" SnapsToDevicePixels="True"
                    PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                    ContextMenuOpening="Card_ContextMenuOpening"
                    AutomationProperties.Name="{Binding Name}">
                <Border.ContextMenu>
                    <ContextMenu/>
                </Border.ContextMenu>
                <!-- Unselected: transparent with a BorderSubtle outline; selected: SurfaceRaised with
                     BorderStrong (set by style so nothing local can outrank the trigger). -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="4" Background="{Binding ColourBrush}"
                                VerticalAlignment="Center" Cursor="Hand" ToolTip="Track colour (right-click the card to change)"
                                AutomationProperties.Name="Track colour"/>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSolo}" Width="28" Height="24" Margin="6,0,0,0"
                                      Content="S" IsChecked="{Binding IsSolo}" AutomationProperties.Name="Solo" ToolTip="Solo"/>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleMute}" Width="28" Height="24" Margin="8,0,0,0"
                                      Content="M" IsChecked="{Binding IsMuted}" AutomationProperties.Name="Mute" ToolTip="Mute"/>
                        <Grid Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontFamily="{StaticResource Sans}" FontSize="14"
                                       FontWeight="Medium" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"
                                       MouseLeftButtonDown="NameText_MouseLeftButtonDown" ToolTip="Double-click to rename"/>
                            <TextBox x:Name="NameBox" Visibility="Collapsed" Style="{StaticResource TextInput}" Height="24"
                                     Padding="4,0" FontFamily="{StaticResource Sans}" FontSize="14" AutomationProperties.Name="Track name"
                                     KeyDown="NameBox_KeyDown" LostKeyboardFocus="NameBox_LostKeyboardFocus"/>
                        </Grid>
                    </DockPanel>

                    <ComboBox Style="{StaticResource Select}" Height="30" Margin="0,7,0,0" Padding="8,0,30,0"
                              FontFamily="{StaticResource Sans}" FontSize="13"
                              ItemsSource="{Binding InstrumentChoices}" SelectedItem="{Binding Instrument, Mode=OneWay}" AutomationProperties.Name="Instrument"
                              ToolTip="Every track plays through the synth chosen in Settings for now; per-track instruments come next."/>

                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Slider Style="{StaticResource SliderFader}" Width="130" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                SmallChange="0.01" LargeChange="0.05" Foreground="{StaticResource InkMuted}"
                                Value="{Binding Volume}" AutomationProperties.Name="Volume"/>
                        <TextBlock Width="58" Margin="8,0,0,0" FontFamily="{StaticResource Mono}" FontSize="11"
                                   Foreground="{StaticResource InkSubtle}" VerticalAlignment="Center">
                            <Run Text="{Binding DbText, Mode=OneWay}"/><Run Text=" dB"/>
                        </TextBlock>
                        <controls:PanControl Value="{Binding Pan}" Foreground="{StaticResource InkSubtle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}" Padding="12,16" AutomationProperties.Name="Tracks">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="4,0,4,12">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Meta}" Foreground="{StaticResource InkSubtle}"
                           Text="{Binding Roll.Tracks.Count, ElementName=Root}" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Overline}" Text="TRACKS" VerticalAlignment="Center"/>
            </DockPanel>

            <Button DockPanel.Dock="Bottom" Height="40" Margin="0,4,0,0" Cursor="Hand" Command="{Binding Roll.AddTrackCommand, ElementName=Root}"
                    AutomationProperties.Name="Add track" Foreground="{StaticResource InkMuted}" FontFamily="{StaticResource Sans}"
                    FontSize="14" FontWeight="Medium">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Face" Background="Transparent">
                            <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Border}" StrokeThickness="1"
                                       StrokeDashArray="4 3" SnapsToDevicePixels="True"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceRaised}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconPlus}" Width="16" Height="16"/>
                    <TextBlock Text="Add track" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="TrackList" ItemsSource="{Binding Roll.Tracks, ElementName=Root}"
                              ItemTemplate="{StaticResource TrackCard}" Focusable="False"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
