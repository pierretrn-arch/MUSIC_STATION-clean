<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- ToneDetector.Audio is now x64-only (native VST3 shim P/Invoke) - match it here so the
         test host doesn't risk a BadImageFormatException loading it. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToneDetector.Core\ToneDetector.Core.csproj" />
    <ProjectReference Include="..\ToneDetector.Audio\ToneDetector.Audio.csproj" />
    <ProjectReference Include="..\ToneDetector.App\ToneDetector.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ToneDetector.Audio\Native\VstShim.dll" Link="VstShim.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
