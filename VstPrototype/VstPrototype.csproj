<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone throwaway prototype per PHASE4-VST3.md Stage 4a. Deliberately NOT referenced by
    ToneDetector.sln and not intended to be kept long-term - see VST-PROTOTYPE-RESULTS.md for
    findings. Windows-only, x64-only per the spec (VST3 on Windows is x64 native, and any host
    interop shim would need to match the plugin's bitness exactly).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
